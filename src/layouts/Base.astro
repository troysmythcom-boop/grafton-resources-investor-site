---
import '../style.css';
import '../pages.css';
const {title = 'Grafton Resources'} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Grafton Resources investor information" />
    <title>{title}</title>
  </head>
  <body><slot />
    <!-- Aurox editor selection bridge (inert unless loaded in the editor with ?wf-edit=1) -->
    <script src="https://aurox-portal.vercel.app/wf-bridge.js" defer></script>
  </body>
</html>
